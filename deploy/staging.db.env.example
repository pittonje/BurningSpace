# Documentation-safe example only, for use with
# deploy/docker-compose.staging.db.yml. Every value below is an obviously
# fake placeholder -- this file is repository preparation, not deployment
# authorization. Real staging preparation must replace every value with a
# freshly generated, operator-managed secret and must NEVER be committed.
#
# See docs/ops/persist-002-staging-db-integration-plan.md for the full
# operator sequence this file supports.

BURNINGSPACE_DB_NAME=burningspace
BURNINGSPACE_DB_ADMIN_USER=burningspace_admin
BURNINGSPACE_DB_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
BURNINGSPACE_DB_MIGRATOR_PASSWORD=REPLACE_WITH_GENERATED_MIGRATOR_PASSWORD
BURNINGSPACE_DB_RUNTIME_PASSWORD=REPLACE_WITH_GENERATED_RUNTIME_PASSWORD
BURNINGSPACE_DB_BACKUP_PASSWORD=REPLACE_WITH_GENERATED_BACKUP_PASSWORD

# Legacy combined example only. For v3, keep the four passwords above in the
# bootstrap projection; the URL below belongs ONLY in the runtime projection.
# MIGRATION_DATABASE_URL and BACKUP_DATABASE_URL each belong in their own file.
# Do not supply this combined example as a real v3 operation projection.
# The application server's own connection string, using the restricted
# burningspace_runtime role -- never the admin, migrator, or backup role.
# Host "postgres" is the internal Compose service DNS name, not a public
# address.
BURNINGSPACE_DATABASE_URL=postgres://burningspace_runtime:REPLACE_WITH_GENERATED_RUNTIME_PASSWORD@postgres:5432/burningspace

BURNINGSPACE_WORLD_SLUG=public-arena
