{
	admin {$BURNINGSPACE_CADDY_ADMIN_ADDRESS}
	persist_config off
	grace_period 30s
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	servers {
		protocols h1 h2
		strict_sni_host on
	}
}

{$BURNINGSPACE_PUBLIC_CLIENT_HOSTNAME} {
	log {
		output file {$BURNINGSPACE_CADDY_LOG_DIRECTORY}/client-access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 72h
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	reverse_proxy 127.0.0.1:{$BURNINGSPACE_CLIENT_BIND_PORT} {
		stream_timeout {$BURNINGSPACE_CADDY_STREAM_TIMEOUT}
		stream_close_delay {$BURNINGSPACE_CADDY_STREAM_CLOSE_DELAY}
		transport http {
			versions 1.1
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 2m
		}
	}
}

{$BURNINGSPACE_PUBLIC_SERVER_HOSTNAME} {
	log {
		output file {$BURNINGSPACE_CADDY_LOG_DIRECTORY}/server-access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 72h
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	reverse_proxy 127.0.0.1:{$BURNINGSPACE_SERVER_BIND_PORT} {
		stream_timeout {$BURNINGSPACE_CADDY_STREAM_TIMEOUT}
		stream_close_delay {$BURNINGSPACE_CADDY_STREAM_CLOSE_DELAY}
		transport http {
			versions 1.1
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 2m
		}
	}
}
