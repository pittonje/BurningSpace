NODE_ENV=production

# Local/CI-only tags used with docker-compose.staging.build.yml. They are not
# valid for the real shared-host staging path.
BURNINGSPACE_SERVER_IMAGE=burningspace-server:local-ci
BURNINGSPACE_CLIENT_IMAGE=burningspace-client:local-ci

BURNINGSPACE_ALLOWED_ORIGINS=https://arena.example.com

# PERSIST002-NET-02: this local/CI topology has no trusted edge in front of
# the server, so admission budgets key from the direct socket peer. The
# explicit "none" sentinel states that deliberately; the variable is required
# by docker-compose.staging.yml and must never be left blank.
BURNINGSPACE_TRUSTED_EDGE_PEERS=none
# PA FIX2: paired with the line above. Direct-peer-only mode requires the same
# explicit "none" here; a real secret alongside "none" peers is a startup
# failure, so an unused secret can never imply configured edge trust.
BURNINGSPACE_EDGE_ASSERTION_SECRET=none
BURNINGSPACE_RECONNECT_GRACE_SECONDS=10
BURNINGSPACE_SHUTDOWN_TIMEOUT_SECONDS=15

BURNINGSPACE_PROFILE_RATE_BURST=8
BURNINGSPACE_PROFILE_RATE_PER_SECOND=1
BURNINGSPACE_INPUT_RATE_BURST=80
BURNINGSPACE_INPUT_RATE_PER_SECOND=40

BURNINGSPACE_SERVER_BIND_PORT=2567
BURNINGSPACE_CLIENT_BIND_PORT=8080

VITE_BURNINGSPACE_SERVER_URL=https://arena-api.example.com
