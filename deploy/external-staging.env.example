# OPS-002 Phase A documentation-safe example only.
# This file is repository preparation, not deployment authorization.
# Copy future real values only to a Git-ignored deploy/.env.* file.
NODE_ENV=production

# Documentation-safe immutable placeholders. Real Phase A/B preparation must
# replace all four values with approved digest-pinned image references.
BURNINGSPACE_SERVER_IMAGE=registry.example.invalid/burningspace/server@sha256:1111111111111111111111111111111111111111111111111111111111111111
BURNINGSPACE_CLIENT_IMAGE=registry.example.invalid/burningspace/client@sha256:2222222222222222222222222222222222222222222222222222222222222222
BURNINGSPACE_PREVIOUS_SERVER_IMAGE=registry.example.invalid/burningspace/server@sha256:3333333333333333333333333333333333333333333333333333333333333333
BURNINGSPACE_PREVIOUS_CLIENT_IMAGE=registry.example.invalid/burningspace/client@sha256:4444444444444444444444444444444444444444444444444444444444444444

BURNINGSPACE_EXTERNAL_ENVIRONMENT_ID=burningspace-staging-01
BURNINGSPACE_PUBLIC_CLIENT_ORIGIN=https://arena.example.invalid
BURNINGSPACE_PUBLIC_SERVER_ORIGIN=https://arena-api.example.invalid
BURNINGSPACE_ALLOWED_ORIGINS=https://arena.example.invalid

# PERSIST002-NET-02 admission-budget attribution. Documentation-safe value:
# the explicit direct-peer-only sentinel. A real public persistence rollout
# MUST replace it, in the Git-ignored deploy/.env.* file, with the exact IP
# literal of the direct socket peer the server container actually observes
# for edge traffic (measured in the target container, never guessed here).
# "none" is direct-peer-only mode and is never rollout acceptance.
BURNINGSPACE_TRUSTED_EDGE_PEERS=none
# PA FIX2/FIX3: the cryptographic proof of the Caddy hop. Documentation-safe
# value: the explicit direct-peer-only sentinel. A real public persistence
# rollout MUST replace BOTH this and the peer list above, in the Git-ignored
# deploy/.env.* file, with a freshly generated 32-byte secret in canonical
# unpadded base64url (exactly 43 characters over [A-Za-z0-9_-]).
# Generate the real value only during the separately authorized rollout;
# see docs/ops/public-arena-caddy-edge-runbook.md.
# The Caddy edge receives the SAME value as a systemd credential, never as
# service environment. Never commit a real secret.
BURNINGSPACE_EDGE_ASSERTION_SECRET=none
VITE_BURNINGSPACE_SERVER_URL=https://arena-api.example.invalid

BURNINGSPACE_SERVER_BIND_PORT=2567
BURNINGSPACE_CLIENT_BIND_PORT=8080
BURNINGSPACE_RECONNECT_GRACE_SECONDS=10
BURNINGSPACE_SHUTDOWN_TIMEOUT_SECONDS=15
BURNINGSPACE_PROFILE_RATE_BURST=8
BURNINGSPACE_PROFILE_RATE_PER_SECOND=1
BURNINGSPACE_INPUT_RATE_BURST=80
BURNINGSPACE_INPUT_RATE_PER_SECOND=40

BURNINGSPACE_EXTERNAL_SMOKE_HOSTILE_ORIGIN=https://hostile.example.invalid
BURNINGSPACE_PREVIOUS_APPROVED_COMMIT=1111111111111111111111111111111111111111
BURNINGSPACE_TARGET_COMMIT=2222222222222222222222222222222222222222
BURNINGSPACE_EDGE_CONFIG_ID=edge-config.example.invalid
BURNINGSPACE_DEPLOYMENT_GO_REFERENCE=NOT-AUTHORIZED
BURNINGSPACE_EXTERNAL_EXECUTION_AUTHORIZED=false
BURNINGSPACE_PUBLIC_PRODUCTION_LAUNCH_AUTHORIZED=false
