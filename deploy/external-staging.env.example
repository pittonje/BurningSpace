# OPS-002 Phase A documentation-safe example only.
# This file is repository preparation, not deployment authorization.
# Copy future real values only to a Git-ignored deploy/.env.* file.
NODE_ENV=production

BURNINGSPACE_EXTERNAL_ENVIRONMENT_ID=public-arena-alpha.example.invalid
BURNINGSPACE_PUBLIC_CLIENT_ORIGIN=https://arena.example.invalid
BURNINGSPACE_PUBLIC_SERVER_ORIGIN=https://arena-api.example.invalid
BURNINGSPACE_ALLOWED_ORIGINS=https://arena.example.invalid
VITE_BURNINGSPACE_SERVER_URL=https://arena-api.example.invalid

BURNINGSPACE_SERVER_BIND_PORT=2567
BURNINGSPACE_CLIENT_BIND_PORT=8080
BURNINGSPACE_RECONNECT_GRACE_SECONDS=10
BURNINGSPACE_SHUTDOWN_TIMEOUT_SECONDS=15
BURNINGSPACE_PROFILE_RATE_BURST=8
BURNINGSPACE_PROFILE_RATE_PER_SECOND=1
BURNINGSPACE_INPUT_RATE_BURST=80
BURNINGSPACE_INPUT_RATE_PER_SECOND=40

BURNINGSPACE_EXTERNAL_SMOKE_HOSTILE_ORIGIN=https://hostile.example.invalid
BURNINGSPACE_PREVIOUS_APPROVED_COMMIT=1111111111111111111111111111111111111111
BURNINGSPACE_TARGET_COMMIT=2222222222222222222222222222222222222222
BURNINGSPACE_EDGE_CONFIG_ID=edge-config.example.invalid
BURNINGSPACE_DEPLOYMENT_GO_REFERENCE=NOT-AUTHORIZED
BURNINGSPACE_EXTERNAL_EXECUTION_AUTHORIZED=false
BURNINGSPACE_PUBLIC_PRODUCTION_LAUNCH_AUTHORIZED=false
