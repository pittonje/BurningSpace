{
  "name": "@burningspace/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:operator": "tsc -p scripts/tsconfig.operator-build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migration-status": "tsx scripts/db-migration-status.ts",
    "world:bootstrap": "tsx scripts/world-bootstrap.ts"
  },
  "dependencies": {
    "@burningspace/protocol": "*",
    "@burningspace/shared": "*",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus": "^0.16.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.16.2"
  }
}
